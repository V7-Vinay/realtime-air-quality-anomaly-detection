# ==========================================
# Real-Time Air Quality Pipeline Configuration
# ==========================================

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TOPIC=air-quality-raw
KAFKA_ALERTS_TOPIC=air-quality-alerts
KAFKA_RAW_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1

# HDFS Configuration
HDFS_NAMENODE_HOST=localhost
HDFS_NAMENODE_PORT=9000
HDFS_WEBHDFS_PORT=9870
HDFS_BASE_PATH=/air_quality
HDFS_RAW_PARQUET_PATH=hdfs://namenode:9000/air_quality/parquet/raw
HDFS_CLEAN_PARQUET_PATH=hdfs://namenode:9000/air_quality/parquet/clean
HDFS_ANOMALIES_PARQUET_PATH=hdfs://namenode:9000/air_quality/parquet/anomalies
HDFS_CHECKPOINT_PATH=hdfs://namenode:9000/air_quality/checkpoints

# Spark Configuration
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_UI_PORT=8085
SPARK_STREAMING_TRIGGER_SECONDS=5

# Streaming Window & Watermark
STREAMING_WATERMARK_DELAY=10 minutes
STREAMING_WINDOW_DURATION=1 hour
STREAMING_SLIDE_DURATION=1 minute

# Anomaly Detection Thresholds (Z-score & Hard Safety Limits)
Z_SCORE_THRESHOLD=3.0

# Hard Safety Limits based on WHO / EPA AQI guidelines
# CO: 10.0 mg/m3 (8-hour WHO standard / hazardous spike)
# Benzene (C6H6): 15.0 ug/m3 (Severe volatile organic compound limit)
# NOx: 400.0 ppb (Severe nitrogen oxides limit)
# NO2: 200.0 ug/m3 (1-hour WHO threshold)
HARD_THRESHOLD_CO=10.0
HARD_THRESHOLD_C6H6=15.0
HARD_THRESHOLD_NOX=400.0
HARD_THRESHOLD_NO2=200.0

# Producer Replay Settings
PRODUCER_REPLAY_INTERVAL_SECONDS=0.1
PRODUCER_INJECT_SPIKES=false
PRODUCER_SPIKE_INTERVAL_RECORDS=20
PRODUCER_SPIKE_MULTIPLIER=4.5

# Latency Verification Target (in seconds)
LATENCY_SLA_SECONDS=300
LATENCY_STRICT_TARGET_SECONDS=60
